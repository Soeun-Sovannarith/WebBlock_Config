# Environment for aicode-service (FastAPI, Pydantic Settings). Defaults target the local-dev stack (../local-dev/compose.yaml).
# Copy to aicode-service/.env for local runs, or load as a Kubernetes ConfigMap. Never put real credentials here.
DATABASE_URL=postgresql+psycopg://webblock:webblock@localhost:5434/aicode_db
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=webblock
RABBITMQ_PASSWORD=webblock
RUN_CONSUMER=true
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/webblock
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/webblock/protocol/openid-connect/certs
PROJECT_SERVICE_URL=http://localhost:8082
REQUEST_TIMEOUT_SECONDS=5.0
